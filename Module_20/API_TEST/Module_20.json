              "raw": "/*{\n  \"title\": \"Getting Started with Node.js\",\n  \"content\": \"Node.js is a JavaScript runtime built on Chrome's V8 engine. It lets you run JavaScript on the server and build fast, scalable network applications.\",\n  \"authorName\": \"Rakib\",\n  \"tags\": \"nodejs,backend,javascript\"\n}\n\n\n{\n  \"title\": \"Understanding MongoDB with Mongoose\",\n  \"content\": \"Mongoose is an ODM library for MongoDB and Node.js. It provides schema validation, middleware, and query helpers that make working with MongoDB much easier.\",\n  \"authorName\": \"Rakib\",\n  \"tags\": \"mongodb,mongoose,database\"\n}\n\n\n{\n  \"title\": \"Understanding Redis with Mongoose\",\n  \"content\": \"Redis (REmote DIctionary Server) is an open-source, in-memory data structure store used primarily as a database, cache, message broker, and streaming engine.  It stores all data in RAM rather than on disk, enabling sub-millisecond latency and extremely high throughput (often exceeding 100,000 operations per second\",\n  \"authorName\": \"Rakib\",\n  \"tags\": \"redis,redis,cookieDB\"\n}\n*/\n\n{\n  \"title\": \"Understanding Debs with Mongoose\",\n  \"content\": \"Redis (REmote DIctionary Server) is an open-source, in-memory data structure store used primarily as a database, cache, gdho broker, and streaming engine.  It stores all data in RAM rather than on disk, enabling sub-millisecond latency and extremely high throughput (often exceeding 100,000 operations per second\",\n  \"authorName\": \"Rakib\",\n  \"tags\": \"redis,kedis,cookieDB\"\n}",
